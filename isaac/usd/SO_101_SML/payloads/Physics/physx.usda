            float physxJointAxis:angular:armature = 0.028
            float physxJointAxis:angular:dynamicFrictionEffort = 0.052
            float physxJointAxis:angular:maxJointVelocity = 572.9578
            float physxJointAxis:angular:staticFrictionEffort = 0.052
            float physxJointAxis:angular:viscousFrictionCoefficient = 0.010471975
        }

        over "elbow_flex" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxJointAxisAPI:angular"]
        )
        {
            float physxJointAxis:angular:armature = 0.028
            float physxJointAxis:angular:dynamicFrictionEffort = 0.052
            float physxJointAxis:angular:maxJointVelocity = 572.9578
            float physxJointAxis:angular:staticFrictionEffort = 0.052
            float physxJointAxis:angular:viscousFrictionCoefficient = 0.010471975
        }

        over "shoulder_lift" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxJointAxisAPI:angular"]
        )
        {
            float physxJointAxis:angular:armature = 0.028
            float physxJointAxis:angular:dynamicFrictionEffort = 0.052
            float physxJointAxis:angular:maxJointVelocity = 572.9578
            float physxJointAxis:angular:staticFrictionEffort = 0.052
            float physxJointAxis:angular:viscousFrictionCoefficient = 0.010471975
        }

        over "shoulder_pan" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxJointAxisAPI:angular"]
        )
        {
            float physxJointAxis:angular:armature = 0.028
            float physxJointAxis:angular:dynamicFrictionEffort = 0.052
            float physxJointAxis:angular:maxJointVelocity = 572.9578
            float physxJointAxis:angular:staticFrictionEffort = 0.052
            float physxJointAxis:angular:viscousFrictionCoefficient = 0.010471975
        }
    }
}

